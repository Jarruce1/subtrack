---
const { user } = Astro.locals;
const path = Astro.url.pathname;

const navLink = "rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:bg-secondary hover:text-foreground";
const current = (href: string) => (path === href || path.startsWith(`${href}/`) ? "page" : undefined);
---

<header
  class="border-border bg-background/85 sticky top-0 z-10 flex items-center justify-between gap-4 border-b px-4 py-2.5 backdrop-blur-sm sm:px-6"
>
  <a href="/" class="text-foreground hover:text-link text-lg font-bold tracking-tight transition-colors">
    Sub<span class="text-link">Track</span>
  </a>
  <nav aria-label="Main" class="flex items-center gap-1 sm:gap-2">
    {
      user ? (
        <>
          <a
            href="/dashboard"
            aria-current={current("/dashboard")}
            class:list={[navLink, current("/dashboard") ? "bg-secondary text-foreground" : "text-muted-foreground"]}
          >
            Dashboard
          </a>
          <a
            href="/subscriptions"
            aria-current={current("/subscriptions")}
            class:list={[navLink, current("/subscriptions") ? "bg-secondary text-foreground" : "text-muted-foreground"]}
          >
            Subscriptions
          </a>
          <span class="text-muted-foreground hidden px-2 text-sm sm:inline">{user.email}</span>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class:list={[navLink, "text-muted-foreground cursor-pointer"]}>
              Sign out
            </button>
          </form>
        </>
      ) : (
        <>
          <a href="/auth/signin" class:list={[navLink, "text-muted-foreground"]}>
            Sign in
          </a>
          <a
            href="/auth/signup"
            class="bg-primary text-primary-foreground hover:bg-primary-hover rounded-lg px-3.5 py-2 text-sm font-semibold transition-colors"
          >
            Sign up
          </a>
        </>
      )
    }
    <button
      type="button"
      data-theme-toggle
      aria-label="Toggle color theme"
      class="border-input bg-card text-foreground hover:border-ring ml-1 inline-flex size-10 cursor-pointer items-center justify-center rounded-lg border transition-colors"
    >
      <svg
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" stroke="none"></path>
      </svg>
    </button>
  </nav>
</header>
