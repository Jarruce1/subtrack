---
const { user } = Astro.locals;
---

<div
  class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-white/80"
>
  <a href="/" class="font-semibold tracking-tight text-white transition-colors hover:text-purple-200">
    Sub<span class="text-purple-300">Track</span>
  </a>
  {
    user ? (
      <div class="flex items-center gap-4">
        <span class="hidden text-blue-100/60 sm:inline">{user.email}</span>
        <a href="/dashboard" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Dashboard
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign out
          </button>
        </form>
      </div>
    ) : (
      <div class="flex items-center gap-4">
        <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Sign in
        </a>
        <a
          href="/auth/signup"
          class="rounded-lg bg-purple-600 px-3 py-1.5 font-medium text-white transition-colors hover:bg-purple-500"
        >
          Sign up
        </a>
      </div>
    )
  }
</div>
