---
import Topbar from "@/components/Topbar.astro";
import { getLang, translator } from "@/lib/i18n";

const { user } = Astro.locals;
const lang = getLang(Astro.cookies);
const t = translator(lang);
---

<Topbar />

<main id="main">
  <div
    class="mx-auto grid max-w-5xl items-center gap-10 px-5 pt-14 pb-14 sm:pt-20 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12"
  >
    <div>
      <p class="text-link mb-5 text-xs font-semibold tracking-[0.14em] uppercase">
        {t("land.badge")}
      </p>
      <h1 class="text-4xl leading-tight sm:text-5xl lg:text-[3.4rem]">
        {t("land.title.pre")}
        <em class="text-link italic">{t("land.title.highlight")}</em>
      </h1>
      <p class="text-muted-foreground mt-6 max-w-[48ch] text-lg sm:text-xl">
        {t("land.lead")}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        {
          user ? (
            <a
              href="/dashboard"
              class="bg-primary text-primary-foreground hover:bg-primary-hover inline-flex min-h-12 items-center justify-center rounded-full px-7 py-3 text-base font-semibold transition-colors"
            >
              {t("land.cta.dashboard")}
            </a>
          ) : (
            <>
              <a
                href="/auth/signup"
                class="bg-primary text-primary-foreground hover:bg-primary-hover inline-flex min-h-12 items-center justify-center rounded-full px-7 py-3 text-base font-semibold transition-colors"
              >
                {t("land.cta.start")}
              </a>
              <a
                href="/auth/signin"
                class="border-input hover:border-foreground hover:bg-card inline-flex min-h-12 items-center justify-center rounded-full border px-7 py-3 text-base font-semibold transition-colors"
              >
                {t("land.cta.signin")}
              </a>
            </>
          )
        }
      </div>

      <div
        class="border-border mt-10 flex flex-wrap gap-x-10 gap-y-4 border-t pt-6"
        aria-label={t("land.summary.aria")}
      >
        <div class="flex flex-col">
          <span class="text-muted-foreground text-xs font-semibold tracking-[0.08em] uppercase">
            {t("land.summary.monthly")}
          </span>
          <span class="font-display text-link text-[1.75rem] font-semibold tabular-nums">PLN 187.46</span>
        </div>
        <div class="flex flex-col">
          <span class="text-muted-foreground text-xs font-semibold tracking-[0.08em] uppercase">
            {t("land.summary.yearly")}
          </span>
          <span class="font-display text-[1.75rem] font-semibold tabular-nums">2,249.52</span>
        </div>
        <div class="flex flex-col">
          <span class="text-muted-foreground text-xs font-semibold tracking-[0.08em] uppercase">
            {t("land.summary.next")}
          </span>
          <span class="font-display text-[1.75rem] font-semibold tabular-nums">{t("land.summary.next.value")}</span>
        </div>
      </div>
    </div>

    <!-- Brand illustration: billing cycles as orbits converging on one total -->
    <div class="grain border-border bg-accent overflow-hidden rounded-3xl border shadow-lg">
      <svg viewBox="0 0 520 560" role="img" aria-label={t("land.summary.aria")} class="block h-auto w-full">
        <circle cx="360" cy="205" r="150" fill="var(--ring)"></circle>
        <circle cx="300" cy="255" r="150" fill="var(--background)" opacity="0.92"></circle>
        <path
          d="M 90 420 A 200 200 0 0 1 290 220"
          fill="none"
          stroke="var(--success-text)"
          stroke-width="34"
          stroke-linecap="round"></path>
        <circle
          cx="300"
          cy="300"
          r="215"
          fill="none"
          stroke="var(--foreground)"
          stroke-width="2"
          stroke-dasharray="2 10"
          opacity="0.55"></circle>
        <circle cx="300" cy="85" r="17" fill="var(--foreground)"></circle>
        <circle cx="512" cy="330" r="12" fill="var(--success-text)"></circle>
        <circle cx="120" cy="150" r="9" fill="var(--link)"></circle>
        <path d="M 120 470 a 74 74 0 0 1 148 0 Z" fill="var(--warning-border)" transform="rotate(180 194 470)"></path>
        <path d="M 330 505 a 58 58 0 0 1 116 0 Z" fill="var(--chart-3)" opacity="0.85"></path>
        <line x1="60" y1="505" x2="470" y2="505" stroke="var(--foreground)" stroke-width="2.5"></line>
      </svg>
    </div>
  </div>

  <div class="bg-secondary border-border border-y">
    <div class="mx-auto grid max-w-5xl grid-cols-1 gap-9 px-5 py-14 sm:grid-cols-3">
      <div>
        <svg width="52" height="52" viewBox="0 0 52 52" aria-hidden="true" class="mb-4">
          <circle cx="26" cy="26" r="24" fill="var(--accent)"></circle>
          <path
            d="M26 12v28 M33 18h-9.5a4.5 4.5 0 0 0 0 9h5a4.5 4.5 0 0 1 0 9H19"
            fill="none"
            stroke="var(--link)"
            stroke-width="2.6"
            stroke-linecap="round"></path>
        </svg>
        <h2 class="mb-2 text-xl">{t("land.f1.title")}</h2>
        <p class="text-muted-foreground text-[15px] leading-relaxed">{t("land.f1.body")}</p>
      </div>
      <div>
        <svg width="52" height="52" viewBox="0 0 52 52" aria-hidden="true" class="mb-4">
          <circle cx="26" cy="26" r="24" fill="var(--success-soft)"></circle>
          <rect x="14" y="15" width="24" height="24" rx="3" fill="none" stroke="var(--success-text)" stroke-width="2.6"
          ></rect>
          <path
            d="M14 22h24 M20 12v6 M32 12v6 M21 30l3.5 3.5L31 27"
            fill="none"
            stroke="var(--success-text)"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <h2 class="mb-2 text-xl">{t("land.f2.title")}</h2>
        <p class="text-muted-foreground text-[15px] leading-relaxed">{t("land.f2.body")}</p>
      </div>
      <div>
        <svg width="52" height="52" viewBox="0 0 52 52" aria-hidden="true" class="mb-4">
          <circle cx="26" cy="26" r="24" fill="var(--warning-soft)"></circle>
          <rect x="15" y="24" width="22" height="14" rx="3" fill="none" stroke="var(--warning-text)" stroke-width="2.6"
          ></rect>
          <path
            d="M19 24v-4a7 7 0 0 1 14 0v4"
            fill="none"
            stroke="var(--warning-text)"
            stroke-width="2.6"
            stroke-linecap="round"></path>
        </svg>
        <h2 class="mb-2 text-xl">{t("land.f3.title")}</h2>
        <p class="text-muted-foreground text-[15px] leading-relaxed">{t("land.f3.body")}</p>
      </div>
    </div>
  </div>

  <section class="mx-auto max-w-5xl px-5 pt-16 pb-20" aria-labelledby="how-heading">
    <h2 id="how-heading" class="text-center text-3xl">{t("land.how.title")}</h2>
    <ol class="mt-11 grid list-none grid-cols-1 gap-9 p-0 sm:grid-cols-3">
      <li class="border-t-[3px] pt-4" style="border-color: var(--ring);">
        <p class="font-display text-link mb-1.5 text-[15px] font-bold">01</p>
        <h3 class="font-display mb-1.5 text-lg font-semibold">{t("land.how.s1.title")}</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">{t("land.how.s1.body")}</p>
      </li>
      <li class="border-t-[3px] pt-4" style="border-color: var(--success-text);">
        <p class="font-display text-success-text mb-1.5 text-[15px] font-bold">02</p>
        <h3 class="font-display mb-1.5 text-lg font-semibold">{t("land.how.s2.title")}</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">{t("land.how.s2.body")}</p>
      </li>
      <li class="border-t-[3px] pt-4" style="border-color: var(--chart-3);">
        <p class="font-display mb-1.5 text-[15px] font-bold" style="color: var(--chart-3);">03</p>
        <h3 class="font-display mb-1.5 text-lg font-semibold">{t("land.how.s3.title")}</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">{t("land.how.s3.body")}</p>
      </li>
    </ol>
  </section>

  <footer class="border-border border-t px-5 py-7">
    <div class="text-muted-foreground mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 text-sm">
      <span class="font-display text-foreground text-base font-bold">
        Sub<span class="text-link">Track</span>
      </span>
      <span>{t("land.footer.note")}</span>
    </div>
  </footer>
</main>
