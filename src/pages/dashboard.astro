---
import Layout from "@/layouts/Layout.astro";
import { authErrorMessage } from "@/lib/auth-errors";
import { createClient } from "@/lib/supabase";
import { listSubscriptions } from "@/lib/services/subscriptions";
import { nextRenewalDate, normalizeCost, summarizeActive, summarizeByCategory, upcomingRenewals } from "@/lib/billing";
import { formatCycle, formatMoney } from "@/lib/format";
import type { CategoryTotal, Subscription } from "@/types";

// SSR over live data: every render recomputes from the store via billing.ts —
// that recompute IS the "no stale aggregates" mechanism. The page only formats.

const supabase = createClient(Astro.request.headers, Astro.cookies);
// Type-level guard only — unreachable behind the middleware gate (an
// authenticated locals.user requires the client). Layout's env banner covers
// the visible messaging.
const subscriptions: Subscription[] = supabase ? await listSubscriptions(supabase) : [];

// Server's UTC date; Workers run UTC (accepted MVP limitation — see billing.ts).
const today = new Date().toISOString().slice(0, 10);

// Failure notice from form-post routes (currently the sign-out fix): ?error=
// carries a short code mapped to a fixed message here (auth-errors.ts) —
// unknown codes collapse to the generic message, so a crafted link cannot put
// chosen text inside this trusted page (content spoofing), and Astro's
// default escaping keeps the value inert either way.
const errorMessage = authErrorMessage(Astro.url.searchParams.get("error"));

const totals = summarizeActive(subscriptions);
const categoryTotals = summarizeByCategory(subscriptions);
// Display grouping only. Relies on summarizeByCategory's sorted-output
// contract (category, then currency): consecutive rows with the same
// category always form one contiguous group.
const categoryGroups: { category: CategoryTotal["category"]; totals: CategoryTotal[] }[] = [];
for (const row of categoryTotals) {
  const last = categoryGroups.at(-1);
  if (last?.category === row.category) {
    last.totals.push(row);
  } else {
    categoryGroups.push({ category: row.category, totals: [row] });
  }
}
const upcoming = upcomingRenewals(subscriptions, today);
const rows = subscriptions.map((subscription) => ({
  subscription,
  normalized: normalizeCost(subscription.amount, subscription.billing_cycle, subscription.billing_interval_months),
  renewal:
    subscription.status === "active"
      ? nextRenewalDate(
          subscription.start_date,
          subscription.billing_cycle,
          subscription.billing_interval_months,
          today,
        )
      : null,
}));
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4 text-white sm:py-10">
    {
      !supabase ? (
        <p class="text-center text-blue-100/80">Supabase is not configured.</p>
      ) : (
        <div class="mx-auto w-full max-w-3xl space-y-6">
          {errorMessage && (
            <p role="alert" class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">
              {errorMessage}
            </p>
          )}
          <header class="flex flex-wrap items-center justify-between gap-3">
            <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
              Dashboard
            </h1>
            <div class="flex items-center gap-2">
              <a href="/subscriptions" class="rounded-lg bg-white/10 px-4 py-2 text-sm hover:bg-white/20">
                Manage
              </a>
              <a
                href="/subscriptions/new"
                class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium transition-colors hover:bg-purple-500"
              >
                Add subscription
              </a>
              <form method="POST" action="/api/auth/signout">
                <button
                  type="submit"
                  class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
                >
                  Sign out
                </button>
              </form>
            </div>
          </header>

          {subscriptions.length === 0 ? (
            <section class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center backdrop-blur-xl">
              <h2 class="text-xl font-semibold">No subscriptions yet</h2>
              <p class="mx-auto mt-2 max-w-md text-sm text-blue-100/80">
                Add your first subscription and this dashboard will show its true monthly and yearly cost plus the next
                renewal date &mdash; across all your billing cycles.
              </p>
              <a
                href="/subscriptions/new"
                class="mt-6 inline-block rounded-lg bg-purple-600 px-5 py-2.5 text-sm font-medium transition-colors hover:bg-purple-500"
              >
                Add your first subscription
              </a>
            </section>
          ) : (
            <>
              <section
                aria-labelledby="totals-heading"
                class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl"
              >
                <h2 id="totals-heading" class="text-lg font-semibold">
                  Active totals
                </h2>
                {totals.length === 0 ? (
                  <p class="mt-2 text-sm text-blue-100/70">No active subscriptions.</p>
                ) : (
                  <ul class="mt-3 divide-y divide-white/10">
                    {totals.map((total) => (
                      <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-2">
                        <span class="font-mono text-sm text-blue-100/70">{total.currency}</span>
                        <span class="text-right">
                          <span class="text-lg font-semibold">{formatMoney(total.monthly, total.currency)}</span>
                          <span class="text-sm text-blue-100/70"> / month</span>
                          <span class="ml-3 text-sm text-blue-100/90">{formatMoney(total.yearly, total.currency)}</span>
                          <span class="text-sm text-blue-100/70"> / year</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </section>

              <section
                aria-labelledby="category-heading"
                class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl"
              >
                <h2 id="category-heading" class="text-lg font-semibold">
                  Costs by category
                </h2>
                {categoryGroups.length === 0 ? (
                  <p class="mt-2 text-sm text-blue-100/70">No active subscriptions.</p>
                ) : (
                  <ul class="mt-3 divide-y divide-white/10">
                    {categoryGroups.map(({ category, totals: categoryRows }) => (
                      <li class="py-2">
                        <p class="font-medium">{category}</p>
                        <ul class="mt-1 space-y-1">
                          {categoryRows.map((total) => (
                            <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                              <span class="font-mono text-sm text-blue-100/70">{total.currency}</span>
                              <span class="text-right">
                                <span class="font-semibold">{formatMoney(total.monthly, total.currency)}</span>
                                <span class="text-sm text-blue-100/70"> / month</span>
                                <span class="ml-3 text-sm text-blue-100/90">
                                  {formatMoney(total.yearly, total.currency)}
                                </span>
                                <span class="text-sm text-blue-100/70"> / year</span>
                              </span>
                            </li>
                          ))}
                        </ul>
                      </li>
                    ))}
                  </ul>
                )}
              </section>

              <section
                aria-labelledby="upcoming-heading"
                class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl"
              >
                <h2 id="upcoming-heading" class="text-lg font-semibold">
                  Upcoming renewals
                </h2>
                {upcoming.length === 0 ? (
                  <p class="mt-2 text-sm text-blue-100/70">No renewals in the next 30 days.</p>
                ) : (
                  <ul class="mt-3 divide-y divide-white/10">
                    {upcoming.map(({ subscription, renewalDate }) => (
                      <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-2">
                        <span>
                          <span class="font-medium">{subscription.name}</span>
                          <span class="ml-3 font-mono text-sm text-blue-100/70">{renewalDate}</span>
                        </span>
                        <span class="text-sm text-blue-100/90">
                          {formatMoney(subscription.amount, subscription.currency)}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </section>

              <section aria-labelledby="subscriptions-heading" class="space-y-3">
                <h2 id="subscriptions-heading" class="text-lg font-semibold">
                  Subscriptions
                </h2>
                <ul class="space-y-3">
                  {rows.map(({ subscription, normalized, renewal }) => (
                    <li class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl sm:p-5">
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <p class="font-semibold">{subscription.name}</p>
                        <span class="rounded-full border border-white/20 bg-white/10 px-2.5 py-0.5 text-xs capitalize">
                          {subscription.status}
                        </span>
                      </div>
                      <p class="mt-1 text-sm text-blue-100/70">
                        {subscription.category} &middot; {formatMoney(subscription.amount, subscription.currency)}{" "}
                        {formatCycle(subscription.billing_cycle, subscription.billing_interval_months)}
                      </p>
                      <dl class="mt-3 grid grid-cols-1 gap-x-4 gap-y-1 text-sm sm:grid-cols-3">
                        <div>
                          <dt class="text-blue-100/60">Monthly</dt>
                          <dd class="font-medium">{formatMoney(normalized.monthly, subscription.currency)}</dd>
                        </div>
                        <div>
                          <dt class="text-blue-100/60">Yearly</dt>
                          <dd class="font-medium">{formatMoney(normalized.yearly, subscription.currency)}</dd>
                        </div>
                        <div>
                          <dt class="text-blue-100/60">Next renewal</dt>
                          <dd class="font-medium">
                            {renewal ?? <span class="capitalize">{subscription.status}</span>}
                          </dd>
                        </div>
                      </dl>
                    </li>
                  ))}
                </ul>
              </section>
            </>
          )}
        </div>
      )
    }
  </div>
</Layout>
