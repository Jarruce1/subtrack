---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import CategoryAvatar from "@/components/CategoryAvatar.astro";
import { authErrorMessage } from "@/lib/auth-errors";
import { createClient } from "@/lib/supabase";
import { listSubscriptions } from "@/lib/services/subscriptions";
import {
  daysUntil,
  nextRenewalDate,
  normalizeCost,
  summarizeActive,
  summarizeByCategory,
  summarizePaused,
  upcomingRenewals,
} from "@/lib/billing";
import { formatMoney } from "@/lib/format";
import { categoryLabel, cyclephrase, getLang, renewalCountdown, statusLabel, translator } from "@/lib/i18n";
import type { CategoryTotal, Subscription } from "@/types";

// SSR over live data: every render recomputes from the store via billing.ts —
// that recompute IS the "no stale aggregates" mechanism. The page only formats.

const lang = getLang(Astro.cookies);
const t = translator(lang);

const supabase = createClient(Astro.request.headers, Astro.cookies);
// Type-level guard only — unreachable behind the middleware gate (an
// authenticated locals.user requires the client). Layout's env banner covers
// the visible messaging.
const subscriptions: Subscription[] = supabase ? await listSubscriptions(supabase) : [];

// Server's UTC date; Workers run UTC (accepted MVP limitation — see billing.ts).
const today = new Date().toISOString().slice(0, 10);

// Failure notice from form-post routes (currently the sign-out fix): ?error=
// carries a short code mapped to a fixed message here (auth-errors.ts) —
// unknown codes collapse to the generic message, so a crafted link cannot put
// chosen text inside this trusted page (content spoofing), and Astro's
// default escaping keeps the value inert either way.
const errorMessage = authErrorMessage(Astro.url.searchParams.get("error"));

const totals = summarizeActive(subscriptions);
const pausedTotals = summarizePaused(subscriptions);
const categoryTotals = summarizeByCategory(subscriptions);
// Display grouping only. Relies on summarizeByCategory's sorted-output
// contract (category, then currency): consecutive rows with the same
// category always form one contiguous group.
const categoryGroups: { category: CategoryTotal["category"]; totals: CategoryTotal[] }[] = [];
for (const row of categoryTotals) {
  const last = categoryGroups.at(-1);
  if (last?.category === row.category) {
    last.totals.push(row);
  } else {
    categoryGroups.push({ category: row.category, totals: [row] });
  }
}
const upcoming = upcomingRenewals(subscriptions, today);
// Share-of-spend bars (decoration): each category row's monthly cost as a
// fraction of its currency's active monthly total.
const totalsByCurrency = new Map(totals.map((total) => [total.currency, total.monthly]));
const shareOf = (currency: string, monthly: number): number => {
  const total = totalsByCurrency.get(currency);
  return total && total > 0 ? Math.max(2, Math.round((monthly / total) * 100)) : 0;
};
const rows = subscriptions.map((subscription) => ({
  subscription,
  normalized: normalizeCost(subscription.amount, subscription.billing_cycle, subscription.billing_interval_months),
  renewal:
    subscription.status === "active"
      ? nextRenewalDate(
          subscription.start_date,
          subscription.billing_cycle,
          subscription.billing_interval_months,
          today,
        )
      : null,
}));
---

<Layout title={`${t("dash.title")} — SubTrack`}>
  <Topbar />
  <main id="main" class="px-4 pb-16 sm:px-6">
    {
      !supabase ? (
        <p class="text-muted-foreground pt-10 text-center">{t("noSupabase")}</p>
      ) : (
        <div class="mx-auto w-full max-w-3xl space-y-6 pt-7">
          {errorMessage && (
            <p
              role="alert"
              class="border-error-text bg-error-soft text-error-text rounded-lg border px-3 py-2 text-sm font-medium"
            >
              {errorMessage}
            </p>
          )}
          <header class="flex flex-wrap items-center justify-between gap-3">
            <h1 class="text-3xl font-bold tracking-tight">{t("dash.title")}</h1>
            <a
              href="/subscriptions/new"
              class="bg-primary text-primary-foreground hover:bg-primary-hover rounded-full px-4 py-2 text-sm font-semibold transition-colors"
            >
              {t("dash.add")}
            </a>
          </header>

          {subscriptions.length === 0 ? (
            <section class="border-border bg-card rounded-2xl border p-8 text-center shadow-sm">
              <h2 class="text-xl font-semibold">{t("dash.empty.title")}</h2>
              <p class="text-muted-foreground mx-auto mt-2 max-w-md text-sm">{t("dash.empty.body")}</p>
              <a
                href="/subscriptions/new"
                class="bg-primary text-primary-foreground hover:bg-primary-hover mt-6 inline-block rounded-full px-5 py-2.5 text-sm font-semibold transition-colors"
              >
                {t("dash.empty.cta")}
              </a>
            </section>
          ) : (
            <>
              <section aria-labelledby="totals-heading" class="border-border bg-card rounded-2xl border p-6 shadow-sm">
                <h2 id="totals-heading" class="text-lg font-semibold">
                  {t("dash.totals")}
                </h2>
                {totals.length === 0 ? (
                  <p class="text-muted-foreground mt-2 text-sm">{t("dash.totals.none")}</p>
                ) : (
                  <ul class="divide-border mt-3 divide-y">
                    {totals.map((total) => (
                      <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-2.5">
                        <span class="bg-accent text-link rounded-md px-2 py-0.5 font-mono text-xs font-bold">
                          {total.currency}
                        </span>
                        <span class="text-right">
                          <span class="text-brand-gradient text-xl font-bold tabular-nums">
                            {formatMoney(total.monthly, total.currency)}
                          </span>
                          <span class="text-muted-foreground text-sm">{t("dash.perMonth")}</span>
                          <span class="ml-3 text-sm font-medium tabular-nums">
                            {formatMoney(total.yearly, total.currency)}
                          </span>
                          <span class="text-muted-foreground text-sm">{t("dash.perYear")}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </section>

              {pausedTotals.length > 0 && (
                <section
                  aria-labelledby="savings-heading"
                  class="border-success-border bg-success-soft/60 rounded-2xl border p-5 shadow-sm"
                >
                  <h2 id="savings-heading" class="text-success-text text-base font-semibold">
                    {t("dash.savings")}
                    <span class="text-muted-foreground ml-2 text-sm font-normal">{t("dash.savings.hint")}</span>
                  </h2>
                  <ul class="mt-2 flex flex-wrap gap-x-8 gap-y-1">
                    {pausedTotals.map((total) => (
                      <li class="text-success-text font-display text-2xl font-semibold tabular-nums">
                        {formatMoney(total.monthly, total.currency)}
                        <span class="text-muted-foreground font-sans text-sm">{t("dash.perMonth")}</span>
                      </li>
                    ))}
                  </ul>
                </section>
              )}

              <section
                aria-labelledby="category-heading"
                class="border-border bg-card rounded-2xl border p-6 shadow-sm"
              >
                <h2 id="category-heading" class="text-lg font-semibold">
                  {t("dash.categories")}
                </h2>
                {categoryGroups.length === 0 ? (
                  <p class="text-muted-foreground mt-2 text-sm">{t("dash.totals.none")}</p>
                ) : (
                  <ul class="divide-border mt-3 divide-y">
                    {categoryGroups.map(({ category, totals: categoryRows }) => (
                      <li class="py-2">
                        <p class="font-semibold">{categoryLabel(lang, category)}</p>
                        <ul class="mt-1 space-y-1">
                          {categoryRows.map((total) => (
                            <li>
                              <span class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                                <span class="text-muted-foreground font-mono text-sm">{total.currency}</span>
                                <span class="text-right">
                                  <span class="font-semibold tabular-nums">
                                    {formatMoney(total.monthly, total.currency)}
                                  </span>
                                  <span class="text-muted-foreground text-sm">{t("dash.perMonth")}</span>
                                  <span class="ml-3 text-sm font-medium tabular-nums">
                                    {formatMoney(total.yearly, total.currency)}
                                  </span>
                                  <span class="text-muted-foreground text-sm">{t("dash.perYear")}</span>
                                </span>
                              </span>
                              <span
                                class="bg-secondary mt-1.5 block h-1.5 overflow-hidden rounded-full"
                                aria-hidden="true"
                              >
                                <span
                                  class="bg-brand-gradient block h-full rounded-full"
                                  style={`width: ${String(shareOf(total.currency, total.monthly))}%`}
                                />
                              </span>
                            </li>
                          ))}
                        </ul>
                      </li>
                    ))}
                  </ul>
                )}
              </section>

              <section
                aria-labelledby="upcoming-heading"
                class="border-border bg-card rounded-2xl border p-6 shadow-sm"
              >
                <h2 id="upcoming-heading" class="text-lg font-semibold">
                  {t("dash.upcoming")}{" "}
                  <span class="text-muted-foreground text-sm font-medium">{t("dash.upcoming.window")}</span>
                </h2>
                {upcoming.length === 0 ? (
                  <p class="text-muted-foreground mt-2 text-sm">{t("dash.upcoming.none")}</p>
                ) : (
                  <ul class="divide-border mt-3 divide-y">
                    {upcoming.map(({ subscription, renewalDate }) => (
                      <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-2">
                        <span class="flex flex-wrap items-center gap-2.5">
                          <span class="font-semibold">{subscription.name}</span>
                          <span class="bg-secondary text-muted-foreground rounded-md px-2 py-0.5 font-mono text-xs font-semibold">
                            {renewalDate}
                          </span>
                          <span
                            class:list={[
                              "rounded-full px-2 py-0.5 text-xs font-semibold",
                              daysUntil(today, renewalDate) <= 3
                                ? "bg-error-soft text-error-text"
                                : daysUntil(today, renewalDate) <= 7
                                  ? "bg-warning-soft text-warning-text"
                                  : "bg-secondary text-muted-foreground",
                            ]}
                          >
                            {renewalCountdown(lang, daysUntil(today, renewalDate))}
                          </span>
                        </span>
                        <span class="text-sm font-medium tabular-nums">
                          {formatMoney(subscription.amount, subscription.currency)}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </section>

              <section aria-labelledby="subscriptions-heading" class="space-y-3">
                <h2 id="subscriptions-heading" class="text-lg font-semibold">
                  {t("dash.subscriptions")}
                </h2>
                <ul class="space-y-3">
                  {rows.map(({ subscription, normalized, renewal }) => (
                    <li class="border-border bg-card card-lift rounded-2xl border p-4 shadow-sm sm:p-5">
                      <div class="flex items-start gap-3.5">
                        <CategoryAvatar name={subscription.name} category={subscription.category} />
                        <div class="min-w-0 flex-1">
                          <div class="flex flex-wrap items-center justify-between gap-2">
                            <p class="font-semibold">{subscription.name}</p>
                            <StatusBadge status={subscription.status} />
                          </div>
                          <p class="text-muted-foreground mt-0.5 text-sm">
                            {categoryLabel(lang, subscription.category)} &middot;{" "}
                            {formatMoney(subscription.amount, subscription.currency)}{" "}
                            {cyclephrase(lang, subscription.billing_cycle, subscription.billing_interval_months)}
                          </p>
                          {subscription.note && (
                            <p class="text-muted-foreground mt-1 truncate text-sm italic" title={subscription.note}>
                              {subscription.note}
                            </p>
                          )}
                        </div>
                      </div>
                      <dl class="mt-3 grid grid-cols-1 gap-x-4 gap-y-1 text-sm sm:grid-cols-3">
                        <div>
                          <dt class="text-muted-foreground">{t("dash.monthly")}</dt>
                          <dd class="font-medium tabular-nums">
                            {formatMoney(normalized.monthly, subscription.currency)}
                          </dd>
                        </div>
                        <div>
                          <dt class="text-muted-foreground">{t("dash.yearly")}</dt>
                          <dd class="font-medium tabular-nums">
                            {formatMoney(normalized.yearly, subscription.currency)}
                          </dd>
                        </div>
                        <div>
                          <dt class="text-muted-foreground">{t("dash.nextRenewal")}</dt>
                          <dd class="font-medium tabular-nums">
                            {renewal ?? <span class="capitalize">{statusLabel(lang, subscription.status)}</span>}
                          </dd>
                        </div>
                      </dl>
                    </li>
                  ))}
                </ul>
              </section>
            </>
          )}
        </div>
      )
    }
  </main>
</Layout>
