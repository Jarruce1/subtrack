---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { getLang, translator } from "@/lib/i18n";

const t = translator(getLang(Astro.cookies));

// Email confirmations are disabled project-wide (supabase config: accounts
// auto-confirm on signup), so this page always reports plain success — the
// "check your email" variant died with the confirmation mails.
const content = {
  emoji: "✅",
  heading: t("auth.confirmed.title"),
  description: t("auth.confirmed.body"),
  linkText: t("auth.confirmed.link"),
};
---

<Layout title={`${content.heading} — SubTrack`}>
  <Topbar />
  <main id="main" class="flex min-h-[calc(100vh-8rem)] items-center justify-center p-4">
    <div class="border-border bg-card w-full max-w-sm rounded-2xl border p-8 text-center shadow-sm">
      <div class="mb-4 text-5xl" aria-hidden="true">{content.emoji}</div>
      <h1 class="mb-3 text-2xl font-bold tracking-tight">{content.heading}</h1>
      <p class="text-muted-foreground mb-6">{content.description}</p>
      <a href="/auth/signin" class="text-link text-sm underline-offset-3 hover:underline">
        {content.linkText}
      </a>
    </div>
  </main>
</Layout>
