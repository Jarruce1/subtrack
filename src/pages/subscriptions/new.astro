---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import SubscriptionForm from "@/components/subscriptions/SubscriptionForm";

// Auth is enforced by middleware (PROTECTED_ROUTES prefix "/subscriptions").
---

<Layout title="Add subscription — SubTrack">
  <Topbar />
  <main id="main" class="px-4 pb-16 sm:px-6">
    <div class="border-border bg-card mx-auto mt-7 w-full max-w-lg rounded-2xl border p-6 shadow-sm sm:p-8">
      <h1 class="mb-6 text-center text-2xl font-bold tracking-tight">Add subscription</h1>
      <SubscriptionForm client:load />
      <p class="mt-4 text-center text-sm">
        <a href="/dashboard" class="text-link underline-offset-3 hover:underline">&larr; Back to dashboard</a>
      </p>
    </div>
  </main>
</Layout>
