---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import DeleteSubscriptionButton from "@/components/subscriptions/DeleteSubscriptionButton";
import StatusActions from "@/components/subscriptions/StatusActions";
import { createClient } from "@/lib/supabase";
import { listSubscriptions } from "@/lib/services/subscriptions";
import { normalizeCost } from "@/lib/billing";
import { formatMoney } from "@/lib/format";
import { categoryLabel, cyclephrase, getLang, translator } from "@/lib/i18n";
import type { Subscription } from "@/types";

// FR-005: every subscription (any status) with status visible and costs
// normalized — the management hub. Renewal dates and totals stay on the
// dashboard (S-05 owns the renewal surface). SSR over live data, same
// recompute-per-render freshness model as the dashboard; auth enforced by
// middleware (PROTECTED_ROUTES prefix "/subscriptions").

const lang = getLang(Astro.cookies);
const t = translator(lang);

const supabase = createClient(Astro.request.headers, Astro.cookies);
// Type-level guard only — unreachable behind the middleware gate.
const subscriptions: Subscription[] = supabase ? await listSubscriptions(supabase) : [];

const rows = subscriptions.map((subscription) => ({
  subscription,
  normalized: normalizeCost(subscription.amount, subscription.billing_cycle, subscription.billing_interval_months),
}));
---

<Layout title={`${t("subs.title")} — SubTrack`}>
  <Topbar />
  <main id="main" class="px-4 pb-16 sm:px-6">
    {
      !supabase ? (
        <p class="text-muted-foreground pt-10 text-center">{t("noSupabase")}</p>
      ) : (
        <div class="mx-auto w-full max-w-3xl space-y-6 pt-7">
          <header class="flex flex-wrap items-center justify-between gap-3">
            <h1 class="text-3xl font-bold tracking-tight">{t("subs.title")}</h1>
            <a
              href="/subscriptions/new"
              class="bg-primary text-primary-foreground hover:bg-primary-hover rounded-lg px-4 py-2 text-sm font-semibold transition-colors"
            >
              {t("dash.add")}
            </a>
          </header>

          {rows.length === 0 ? (
            <section class="border-border bg-card rounded-2xl border p-8 text-center shadow-sm">
              <h2 class="text-xl font-semibold">{t("subs.empty.title")}</h2>
              <p class="text-muted-foreground mx-auto mt-2 max-w-md text-sm">{t("subs.empty.body")}</p>
              <a
                href="/subscriptions/new"
                class="bg-primary text-primary-foreground hover:bg-primary-hover mt-6 inline-block rounded-lg px-5 py-2.5 text-sm font-semibold transition-colors"
              >
                {t("dash.empty.cta")}
              </a>
            </section>
          ) : (
            <ul class="space-y-3">
              {rows.map(({ subscription, normalized }) => (
                <li class="border-border bg-card rounded-2xl border p-4 shadow-sm sm:p-5">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <p class="font-semibold">{subscription.name}</p>
                    <StatusBadge status={subscription.status} />
                  </div>
                  <p class="text-muted-foreground mt-1 text-sm">
                    {categoryLabel(lang, subscription.category)} &middot;{" "}
                    {formatMoney(subscription.amount, subscription.currency)}{" "}
                    {cyclephrase(lang, subscription.billing_cycle, subscription.billing_interval_months)}
                  </p>
                  <div class="mt-3 flex flex-wrap items-end justify-between gap-3">
                    <dl class="grid grid-cols-2 gap-x-6 gap-y-1 text-sm">
                      <div>
                        <dt class="text-muted-foreground">{t("dash.monthly")}</dt>
                        <dd class="font-medium tabular-nums">
                          {formatMoney(normalized.monthly, subscription.currency)}
                        </dd>
                      </div>
                      <div>
                        <dt class="text-muted-foreground">{t("dash.yearly")}</dt>
                        <dd class="font-medium tabular-nums">
                          {formatMoney(normalized.yearly, subscription.currency)}
                        </dd>
                      </div>
                    </dl>
                    <div class="flex flex-wrap items-center gap-2">
                      <StatusActions
                        client:load
                        lang={lang}
                        id={subscription.id}
                        name={subscription.name}
                        status={subscription.status}
                      />
                      <a
                        href={`/subscriptions/${subscription.id}/edit`}
                        class="border-input bg-card hover:bg-accent hover:border-ring rounded-lg border px-3 py-1.5 text-sm font-medium transition-colors"
                      >
                        {t("subs.edit")}
                      </a>
                      <DeleteSubscriptionButton client:load lang={lang} id={subscription.id} name={subscription.name} />
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }
  </main>
</Layout>
