---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";
import { getLang, translator } from "@/lib/i18n";

interface Props {
  title?: string;
}

const lang = getLang(Astro.cookies);
const t = translator(lang);

const { title = "SubTrack — know what your subscriptions really cost" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={t("meta.description")} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <script is:inline>
      // Theme boot before first paint (no FOUC): saved choice wins, else OS preference.
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("subtrack-theme");
        } catch {
          /* storage blocked — fall back to OS preference */
        }
        const dark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
        window.addEventListener("click", (event) => {
          if (!(event.target instanceof Element)) return;
          if (event.target.closest("[data-theme-toggle]")) {
            const isDark = document.documentElement.classList.toggle("dark");
            try {
              localStorage.setItem("subtrack-theme", isDark ? "dark" : "light");
            } catch {
              /* storage blocked — theme still toggles for this page */
            }
            return;
          }
          const langButton = event.target.closest("[data-lang-toggle]");
          if (langButton) {
            // Language lives in a cookie (not localStorage) so SSR renders the
            // right strings on the very next request; reload re-renders now.
            const next = langButton.getAttribute("data-lang-toggle");
            document.cookie = "subtrack-lang=" + next + "; path=/; max-age=31536000; samesite=lax";
            window.location.reload();
          }
        });
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="bg-primary text-primary-foreground absolute -top-12 left-2 z-50 rounded-lg px-4 py-2 font-semibold transition-[top] focus-visible:top-2"
    >
      {t("skip")}
    </a>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
