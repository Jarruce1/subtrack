---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
}

const { title = "SubTrack — know what your subscriptions really cost" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Track every subscription in one place: true monthly and yearly totals across mixed billing cycles, plus exact upcoming renewal dates."
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <script is:inline>
      // Theme boot before first paint (no FOUC): saved choice wins, else OS preference.
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("subtrack-theme");
        } catch {
          /* storage blocked — fall back to OS preference */
        }
        const dark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
        window.addEventListener("click", (event) => {
          if (!(event.target instanceof Element) || !event.target.closest("[data-theme-toggle]")) return;
          const isDark = document.documentElement.classList.toggle("dark");
          try {
            localStorage.setItem("subtrack-theme", isDark ? "dark" : "light");
          } catch {
            /* storage blocked — theme still toggles for this page */
          }
        });
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="bg-primary text-primary-foreground absolute -top-12 left-2 z-50 rounded-lg px-4 py-2 font-semibold transition-[top] focus-visible:top-2"
    >
      Skip to content
    </a>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
