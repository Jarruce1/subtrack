+/**
+ * Polish plural form for a count of subscriptions, used in dashboard
+ * summaries (PRD FR-006: "N subskrypcji aktywnych").
+ *
+ * Polish has three plural forms:
+ *  - 1            -> "subskrypcja"
+ *  - 2-4, 22-24…  -> "subskrypcje" (except 12-14)
+ *  - everything else -> "subskrypcji"
+ */
+export function subscriptionLabel(count: number): string {
+  if (!Number.isInteger(count) || count < 0) {
+    throw new RangeError(`count must be a non-negative integer, got ${count}`);
+  }
+  if (count === 1) return "subskrypcja";
+  const lastTwo = count % 100;
+  const last = count % 10;
+  const isFewForm = last >= 2 && last <= 4 && !(lastTwo >= 12 && lastTwo <= 14);
+  return isFewForm ? "subskrypcje" : "subskrypcji";
+}
