+import { describe, expect, it } from "vitest";
+import { subscriptionLabel } from "./pluralize";
+
+// Oracles hand-derived from Polish grammar rules cited in the PRD copy
+// (FR-006), not from the implementation.
+describe("subscriptionLabel", () => {
+  it("uses singular for exactly 1", () => {
+    expect(subscriptionLabel(1)).toBe("subskrypcja");
+  });
+
+  it("uses the few-form for 2-4", () => {
+    expect(subscriptionLabel(2)).toBe("subskrypcje");
+    expect(subscriptionLabel(3)).toBe("subskrypcje");
+    expect(subscriptionLabel(4)).toBe("subskrypcje");
+  });
+
+  it("uses the many-form for 0, 5-21 and the 12-14 exception", () => {
+    expect(subscriptionLabel(0)).toBe("subskrypcji");
+    expect(subscriptionLabel(5)).toBe("subskrypcji");
+    expect(subscriptionLabel(12)).toBe("subskrypcji");
+    expect(subscriptionLabel(13)).toBe("subskrypcji");
+    expect(subscriptionLabel(14)).toBe("subskrypcji");
+    expect(subscriptionLabel(21)).toBe("subskrypcji");
+  });
+
+  it("applies the few-form again for 22-24, 32-34, ...", () => {
+    expect(subscriptionLabel(22)).toBe("subskrypcje");
+    expect(subscriptionLabel(34)).toBe("subskrypcje");
+    expect(subscriptionLabel(102)).toBe("subskrypcje");
+  });
+
+  it("rejects negative and non-integer counts", () => {
+    expect(() => subscriptionLabel(-1)).toThrow(RangeError);
+    expect(() => subscriptionLabel(1.5)).toThrow(RangeError);
+    expect(() => subscriptionLabel(Number.NaN)).toThrow(RangeError);
+  });
+});
